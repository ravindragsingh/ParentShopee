# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# SQLite database (local dev only — use PostgreSQL on Render)
backend/*.db
backend/*.db-shm
backend/*.db-wal

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# Environment
.env
.env.local
*.env

# OS
.DS_Store
Thumbs.db

# Android release signing key -- never commit (see frontend/android/app/build.gradle)
frontend/android/keystore.properties
frontend/android/app/*.keystore

# Piper TTS voice models -- large (60MB+), downloadable, not source (see tools/tts-piper/README.md)
tools/tts-piper/*.onnx
tools/tts-piper/*.onnx.json

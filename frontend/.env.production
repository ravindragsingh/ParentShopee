VITE_API_URL=https://parentshopee.onrender.com

# Firebase Auth -- the real project (rewardurkids-dab22), not the local Auth
# Emulator placeholders in .env.local. Vite loads .env.local on top of every
# mode including production, so without these set here explicitly, a
# production build picks up whatever's in .env.local on the machine that
# built it -- which is exactly what shipped the auth/network-request-failed
# bug that got the Play Store submission rejected: the Android build was
# unknowingly pointed at localhost:9099 (the dev-only Auth Emulator), which
# doesn't exist on any real device. These are public client identifiers
# (protected by Firebase Security Rules, not secrecy), safe to commit --
# same values as the live website already uses.
VITE_FIREBASE_API_KEY=AIzaSyAATHe5IifGuR5s2sV4AWf1S4tv1OLCVOU
VITE_FIREBASE_AUTH_DOMAIN=rewardurkids-dab22.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rewardurkids-dab22
VITE_FIREBASE_APP_ID=1:1093823710496:web:774e2777711cd66d058345

# Google Sign-In (native). Reuses the same "Web application" OAuth client
# already used on the website -- Android's Credential Manager and iOS both
# take this as the audience for the ID token they hand back.
VITE_GOOGLE_CLIENT_ID=726174787032-p2mqvn74f7adnsmjml56n4qi8hpdfkn5.apps.googleusercontent.com

# iOS OAuth client (bundle ID com.rewardurkids.app).
VITE_GOOGLE_IOS_CLIENT_ID=726174787032-bpme6fp1f0greaf7arelrpoaokqbki1f.apps.googleusercontent.com

# Android OAuth client ("4th Android" in Google Cloud Console) used for the
# browser-based Google Sign-In flow on Android -- see nativeGoogleAuth.js for
# why Android doesn't use the Credential Manager plugin like iOS does.
VITE_GOOGLE_ANDROID_CLIENT_ID=726174787032-qmt7lsnh0p4jgemon6re66eqe6bsielv.apps.googleusercontent.com

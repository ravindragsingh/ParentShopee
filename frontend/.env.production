VITE_API_URL=https://parentshopee.onrender.com

# Google Sign-In (native). Reuses the same "Web application" OAuth client
# already used on the website -- Android's Credential Manager and iOS both
# take this as the audience for the ID token they hand back.
VITE_GOOGLE_CLIENT_ID=726174787032-p2mqvn74f7adnsmjml56n4qi8hpdfkn5.apps.googleusercontent.com

# iOS OAuth client (bundle ID com.rewardurkids.app).
VITE_GOOGLE_IOS_CLIENT_ID=726174787032-bpme6fp1f0greaf7arelrpoaokqbki1f.apps.googleusercontent.com

# Android OAuth client ("4th Android" in Google Cloud Console) used for the
# browser-based Google Sign-In flow on Android -- see nativeGoogleAuth.js for
# why Android doesn't use the Credential Manager plugin like iOS does.
VITE_GOOGLE_ANDROID_CLIENT_ID=726174787032-qmt7lsnh0p4jgemon6re66eqe6bsielv.apps.googleusercontent.com

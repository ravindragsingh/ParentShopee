VITE_API_URL=https://parentshopee.onrender.com

# Google Sign-In (native). Reuses the same "Web application" OAuth client
# already used on the website -- Android's Credential Manager and iOS both
# take this as the audience for the ID token they hand back.
VITE_GOOGLE_CLIENT_ID=726174787032-p2mqvn74f7adnsmjml56n4qi8hpdfkn5.apps.googleusercontent.com

# iOS also needs its own "iOS" type OAuth client (bundle ID com.rewardurkids.app).
# Until this is set, the Google button simply stays hidden on iOS (Android
# only needs VITE_GOOGLE_CLIENT_ID above).
# VITE_GOOGLE_IOS_CLIENT_ID=
